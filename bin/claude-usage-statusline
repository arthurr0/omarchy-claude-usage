#!/usr/bin/env python3
import json
import os
import pathlib
import sys
import time

HOME = pathlib.Path.home()
CACHE_DIR = pathlib.Path(os.environ.get("XDG_CACHE_HOME") or (HOME / ".cache")) / "claude-usage"
CACHE = CACHE_DIR / "statusline.json"


def store(rate_limits):
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"fetched_at": int(time.time()), "rate_limits": rate_limits}))
        tmp.replace(CACHE)
    except Exception:
        pass


def short_path(cwd):
    if not cwd:
        return ""
    path = pathlib.Path(cwd)
    try:
        return "~/" + str(path.relative_to(HOME))
    except ValueError:
        return str(path)


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0

    rate_limits = payload.get("rate_limits")
    if isinstance(rate_limits, dict):
        store(rate_limits)

    parts = []
    directory = short_path((payload.get("workspace") or {}).get("current_dir") or payload.get("cwd"))
    if directory:
        parts.append(directory)
    model = (payload.get("model") or {}).get("display_name")
    if model:
        parts.append(model)

    usage = []
    for key, label in (("five_hour", "5h"), ("seven_day", "7d")):
        window = (rate_limits or {}).get(key)
        if isinstance(window, dict) and isinstance(window.get("used_percentage"), (int, float)):
            usage.append("%s %d%%" % (label, round(window["used_percentage"])))
    if usage:
        parts.append(" ".join(usage))

    print(" | ".join(parts))
    return 0


if __name__ == "__main__":
    sys.exit(main())
